# Supabase project (Project Settings → API). The anon key is public; never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string, used only by scripts/ (migrations, granting staff roles). Never exposed to the browser.
DATABASE_URL=

# Public URL of the site, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional integrations
# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to use first-party analytics only.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Webhook called with JSON for every new lead (Slack incoming webhook, Zapier, Make, n8n, ...).
LEAD_WEBHOOK_URL=
# Random secret for hashing unique visitors in first-party analytics (falls back to the anon key).
ANALYTICS_SALT=
